# Local Docker Compose only. Copy to .env.compose and replace both values.
# Use a SQL Server password with upper/lowercase letters, digits, and a URL-safe underscore.
MSSQL_SA_PASSWORD=ChangeMe_2026
JWT_SECRET=replace_with_a_long_random_secret
APP_PORT=8080
SQLSERVER_PORT=1433

# Optional ETL automation (enabled with --profile automation).
ETL_INTERVAL_SECONDS=3600
ETL_RETRY_ATTEMPTS=3
ETL_RETRY_DELAY_SECONDS=30
ETL_MAX_RETRY_DELAY_SECONDS=300
ETL_OVERLAP_MINUTES=5
