// Dán vào https://dbdiagram.io để vẽ ERD (xuất ra docs/erd.png).
// Phản chiếu database_scripts/01_init_schema.sql

Table categories {
  category_id int [pk, increment]
  category_name nvarchar(50) [unique, not null]
}

Table users {
  user_id int [pk, increment]
  student_id varchar(10) [unique, not null, note: '8 chữ số, trùng phần trước @ của email']
  email varchar(100) [unique, not null, note: "CHECK LIKE '%@gm.uit.edu.vn'"]
  password_hash varchar(100) [not null, note: 'bcrypt']
  full_name nvarchar(100) [not null]
  major nvarchar(50)
  created_at datetime2 [not null, note: 'UTC']
  updated_at datetime2 [not null, note: 'UTC - dùng làm watermark cho Incremental ETL']
}

Table products {
  product_id int [pk, increment]
  seller_id int [not null, ref: > users.user_id]
  category_id int [not null, ref: > categories.category_id]
  title nvarchar(200) [not null]
  description nvarchar(max)
  price decimal(10,2) [not null, note: 'CHECK >= 0']
  condition varchar(20) [not null, note: "Brand New | Like New | Good | Fair"]
  status varchar(20) [not null, default: 'Available', note: "Available | Reserved | Sold | Hidden"]
  created_at datetime2 [not null]
  updated_at datetime2 [not null]

  indexes {
    (category_id, status, created_at)
    seller_id
    title
    updated_at
  }
}

Table transactions {
  transaction_id int [pk, increment]
  product_id int [not null, ref: > products.product_id]
  buyer_id int [not null, ref: > users.user_id]
  amount decimal(10,2) [not null, note: 'giá chốt, CHECK >= 0']
  status varchar(20) [not null, default: 'Pending', note: "Pending | Accepted | Completed | Cancelled"]
  transaction_date datetime2 [not null, note: "thời điểm buyer gửi yêu cầu"]
  updated_at datetime2 [not null]
  buyer_confirmed_at datetime2 [note: "thời điểm buyer xác nhận hoàn tất"]
  seller_confirmed_at datetime2 [note: "thời điểm seller xác nhận hoàn tất"]

  indexes {
    product_id [unique, note: "filtered: WHERE status <> 'Cancelled' (mỗi sản phẩm tối đa 1 giao dịch đang sống)"]
    buyer_id
    transaction_date
    updated_at
  }
}
