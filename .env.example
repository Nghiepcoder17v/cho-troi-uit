# Copy file này thành ".env" (đặt ở THƯ MỤC GỐC repo) rồi điền giá trị thật. KHÔNG commit file .env.

# --- SQL Server (chọn 1 trong 2 cách) ---
# Cách 1: đăng nhập bằng SQL login
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost/ChoTroUIT?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Cách 2: Windows Authentication
# DATABASE_URL=mssql+pyodbc://@localhost/ChoTroUIT?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# --- JWT ---
# Tạo bằng:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Thời hạn token (phút), mặc định 1440 = 24 giờ
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origins, phân cách bằng dấu phẩy khi có nhiều origin
# CORS_ORIGINS=http://localhost:5173

# --- Data Warehouse (database RIÊNG, tạo trước:  CREATE DATABASE ChoTroUIT_DWH;) ---
# Phải khác DATABASE_URL: ETL từ chối chạy nếu hai URL trùng nhau.
DWH_DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost/ChoTroUIT_DWH?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Windows Authentication:
# DWH_DATABASE_URL=mssql+pyodbc://@localhost/ChoTroUIT_DWH?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
